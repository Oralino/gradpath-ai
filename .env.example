# Copy to .env (never commit .env). Placeholder names only.

# LLM provider: claude_code (local, your Claude subscription) | anthropic_api | fake (tests)
LLM_PROVIDER=claude_code
ANTHROPIC_API_KEY=

# Embeddings
VOYAGE_API_KEY=

# Vector store: leave QDRANT_URL empty for local embedded mode
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=backend/data/qdrant
# Deployed index (Qdrant Cloud), used only by `python -m gradpath.ingestion.copy_index` (T-020);
# keep QDRANT_URL empty here so local runs stay on the local index
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=

# LangSmith (optional; the app runs without it). Tracing needs both lines below and is always off
# in live mode. Traces hold full prompts: use public postings and the sample profile only.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gradpath-dev

# Career workflow: critic -> revise rounds before the result is returned (0-3)
WORKFLOW_MAX_REVISIONS=1
# Seconds one workflow run may take before it stops with a labelled partial result (30-1800)
WORKFLOW_TIME_BUDGET_S=300

# Route log for POST /api/assist: one JSON line per request, no request text ("" turns it off)
ROUTE_LOG_PATH=logs/routes.jsonl

# App mode (T-018): local = your machine, server credentials, tracing allowed;
# demo = deployed, recorded runs only, no keys needed; live = deployed, a visitor's own key.
APP_MODE=local
# Recorded runs for demo mode, relative to the repo root
DEMO_RUNS_PATH=demo_runs
# Live mode only: Sign in with GitHub (T-026). A GitHub OAuth App (no scopes) whose callback URL is
# PUBLIC_SITE_URL/api/auth/github/callback; live refuses to start without these four.
# Leave empty for local and demo.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs the session cookie: 32+ random printable characters, no spaces
SESSION_SECRET=
# The public site's origin, no trailing slash (http://127.0.0.1:3000 to test live mode locally)
PUBLIC_SITE_URL=
# GitHub accounts younger than this many days are refused; sign-ins last SESSION_TTL_S seconds
GITHUB_MIN_ACCOUNT_AGE_DAYS=30
SESSION_TTL_S=86400
# Comma-separated GitHub logins or numeric ids refused even with a valid sign-in
GITHUB_BLOCKED_USERS=
# Proxies in front of the API that append to X-Forwarded-For (0 locally; set for the deploy host)
TRUSTED_PROXY_HOPS=0
# Browser origins allowed to POST (comma-separated, exact scheme://host[:port]); add the deployed
# frontend's address. Empty refuses every browser POST (requests with no Origin still pass).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
