# Copy to .env (never commit .env). Placeholder names only.

# LLM provider: claude_code (local, your Claude subscription) | anthropic_api | fake (tests)
LLM_PROVIDER=claude_code
ANTHROPIC_API_KEY=

# Embeddings
VOYAGE_API_KEY=

# Vector store: leave QDRANT_URL empty for local embedded mode
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=backend/data/qdrant

# LangSmith (optional; the app runs without it). Tracing needs both lines below and is always off
# in live mode. Traces hold full prompts: use public postings and the sample profile only.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gradpath-dev

# App mode on the deployed site: demo | live
APP_MODE=demo
