# Copy to .env (never commit .env). Placeholder names only.

# LLM provider: claude_code (local, your Claude subscription) | anthropic_api | fake (tests)
LLM_PROVIDER=claude_code
ANTHROPIC_API_KEY=

# Embeddings
VOYAGE_API_KEY=

# Vector store: leave QDRANT_URL empty for local embedded mode
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=backend/data/qdrant

# LangSmith (optional; the app runs without it). Tracing needs both lines below and is always off
# in live mode. Traces hold full prompts: use public postings and the sample profile only.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gradpath-dev

# Career workflow: critic -> revise rounds before the result is returned (0-3)
WORKFLOW_MAX_REVISIONS=1
# Seconds one workflow run may take before it stops with a labelled partial result (30-1800)
WORKFLOW_TIME_BUDGET_S=300

# Route log for POST /api/assist: one JSON line per request, no request text ("" turns it off)
ROUTE_LOG_PATH=logs/routes.jsonl

# App mode (T-018): local = your machine, server credentials, tracing allowed;
# demo = deployed, recorded runs only, no keys needed; live = deployed, a visitor's own key.
APP_MODE=local
# Recorded runs for demo mode, relative to the repo root
DEMO_RUNS_PATH=demo_runs
# Live mode only: the shared passcode visitors must send (16+ random characters; live refuses to
# start without it). Leave empty for local and demo.
LIVE_PASSCODE=
# Proxies in front of the API that append to X-Forwarded-For (0 locally; set for the deploy host)
TRUSTED_PROXY_HOPS=0
